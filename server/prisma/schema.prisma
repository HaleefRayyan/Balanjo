// Skema database Balanjo (PostgreSQL di Neon).
// DATABASE_URL = koneksi "pooled" Neon (dipakai aplikasi; aman untuk serverless di Vercel)
// DIRECT_URL   = koneksi langsung (dipakai Prisma untuk migrasi)
// Catatan: role/status disimpan sebagai String (lihat src/constants.js) supaya mudah diubah.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String // nama tampilan (display name)
  firstName           String?
  lastName            String?
  username            String               @unique
  email               String               @unique
  passwordHash        String
  role                String               @default("USER") // USER | ADMIN
  avatarUrl           String? // foto profil (upload), null = pakai inisial nama
  createdAt           DateTime             @default(now())
  blogs               Blog[]
  forumPosts          ForumPost[]
  comments            Comment[]
  products            Product[]
  orders              Order[]
  sales               OrderItem[] // item pesanan untuk produk yang dia jual
  bannerRequests      BannerRequest[]
  resetTokens         PasswordResetToken[]
  reviews             Review[]
  cartItems           CartItem[]
  // rekening / e-wallet tujuan payout (diisi seller di Seller Centre)
  payoutMethod        String? // mis. BCA, BRI, GoPay, DANA
  payoutAccountNumber String?
  payoutAccountName   String?
  payouts             Payout[]             @relation("SellerPayouts")
  processedPayouts    Payout[]             @relation("ProcessedPayouts")
  processedRefunds    Refund[]             @relation("ProcessedRefunds")
  notifications       Notification[]
  emailNotifications  Boolean              @default(true) // kirim notifikasi juga ke email
}

model Blog {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  category  String
  body      String // HTML yang sudah disanitasi saat disimpan
  coverUrl  String?
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([category])
}

model ForumPost {
  id        Int       @id @default(autoincrement())
  text      String
  category  String
  imageUrl  String?
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime  @default(now())

  @@index([category])
}

model Comment {
  id        Int       @id @default(autoincrement())
  text      String
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  category       String
  price          Int // Rupiah
  description    String
  photoUrl       String // foto sampul (= foto pertama di photos)
  photos         ProductPhoto[]
  variants       ProductVariant[]
  stock          Int              @default(0) // total stok; kalau ada variasi = jumlah stok semua variasi
  sellerId       Int?
  seller         User?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  bannerRequests BannerRequest[]
  reviews        Review[]
  cartItems      CartItem[]
  createdAt      DateTime         @default(now())

  @@index([category])
}

model Order {
  id               Int         @id @default(autoincrement())
  userId           Int
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total            Int // subtotal produk + ongkos antar
  shippingFee      Int         @default(0)
  // pengiriman (diisi saat checkout)
  deliveryMethod   String      @default("PICKUP") // PICKUP (ambil di kampus) | DELIVERY (antar di area kampus)
  recipientName    String      @default("")
  phone            String      @default("")
  address          String? // titik temu / alamat, wajib untuk DELIVERY
  note             String?
  // pembayaran (Midtrans Snap). Pesanan lama / tanpa Midtrans dianggap sudah dibayar.
  paymentStatus    String      @default("PAID") // UNPAID | PAID | EXPIRED | FAILED | CANCELLED
  paymentRef       String?     @unique // order_id di Midtrans (unik per percobaan)
  paymentToken     String? // token Snap, dipakai ulang selama belum kedaluwarsa
  paymentType      String? // mis. qris, gopay, bank_transfer
  paymentExpiresAt DateTime?
  paidAt           DateTime?
  refunds          Refund[]
  items            OrderItem[] // status ada per item, karena satu pesanan bisa berisi produk dari beberapa seller
  createdAt        DateTime    @default(now())
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerId    Int? // salinan seller saat dibeli: penjualan tetap terlihat walau produknya dihapus
  seller      User?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  name        String // salinan nama & harga saat dibeli, supaya riwayat tidak berubah
  price       Int
  variant     String?
  quantity    Int
  status      String   @default("PENDING") // PENDING | PROCESSING | SHIPPED | DONE | CANCELLED
  platformFee Int      @default(0) // potongan platform (dihitung saat checkout dari PLATFORM_FEE_PERCENT)
  review      Review?
  refund      Refund?

  @@index([sellerId])
}

// Ulasan hanya dari pembeli yang item pesanannya sudah Selesai, satu ulasan per item pesanan
model Review {
  id          Int       @id @default(autoincrement())
  rating      Int // 1-5
  comment     String    @default("")
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([productId])
}

// Keranjang user yang login (tersimpan di server, sama di semua perangkat).
// Tamu memakai keranjang di browser; digabung ke sini saat login.
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   String   @default("") // "" = tanpa variasi
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId, variant])
}

model Banner {
  id        Int            @id @default(autoincrement())
  label     String
  imageUrl  String
  position  Int            @default(0)
  request   BannerRequest?
  createdAt DateTime       @default(now())
}

model BannerRequest {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  Int
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  imageUrl  String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  bannerId  Int?     @unique // banner yang dibuat saat disetujui
  banner    Banner?  @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique // sha256 dari token; token aslinya hanya ada di link reset
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

// Penarikan saldo seller. Uang ditransfer manual oleh admin, lalu ditandai PAID.
// Saldo = penghasilan item Selesai (dibayar online) - payout yang belum ditolak.
model Payout {
  id            Int       @id @default(autoincrement())
  sellerId      Int
  seller        User      @relation("SellerPayouts", fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Int
  status        String    @default("PENDING") // PENDING | PAID | REJECTED
  // salinan rekening saat diajukan
  method        String
  accountNumber String
  accountName   String
  adminNote     String? // mis. nomor referensi transfer / alasan ditolak
  processedById Int?
  processedBy   User?     @relation("ProcessedPayouts", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([sellerId])
  @@index([status])
}

// Pengembalian dana ke pembeli untuk pesanan yang sudah dibayar online.
// Dibuat otomatis: item dibatalkan seller setelah dibayar, atau pembayaran masuk setelah pesanan ditutup.
// Admin mengembalikan dana secara manual (dashboard Midtrans / transfer), lalu menandai REFUNDED.
model Refund {
  id            Int        @id @default(autoincrement())
  key           String     @unique // "item:<id>" / "late:<orderId>": satu refund per kejadian
  orderId       Int
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   Int?       @unique
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  amount        Int
  reason        String // SELLER_CANCELLED | LATE_PAYMENT
  description   String
  status        String     @default("PENDING") // PENDING | REFUNDED
  adminNote     String?
  processedById Int?
  processedBy   User?      @relation("ProcessedRefunds", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  createdAt     DateTime   @default(now())

  @@index([orderId])
  @@index([status])
}

// Notifikasi di website (ikon lonceng). Event penting juga dikirim ke email kalau user mengizinkan.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // mis. ORDER_PAID, NEW_ORDER, ITEM_STATUS, REFUND_DONE, PAYOUT_PAID
  title     String
  body      String
  link      String? // path di website, mis. /profile/orders
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Variasi produk dengan stok masing-masing (mis. Hitam: 3, Coklat: 0)
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  stock     Int     @default(0)
  position  Int     @default(0)

  @@unique([productId, name])
}

// Foto produk (maks. 5). Foto dengan position terkecil = sampul (Product.photoUrl)
model ProductPhoto {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}
