# Disalin ke .env oleh `npm run setup` (JWT_SECRET diisi acak otomatis).

# Neon (https://console.neon.tech) > project > Connect. Pakai branch database untuk development.
# DATABASE_URL = connection string "Pooled connection" (ada "-pooler" di host-nya)
# DIRECT_URL   = connection string yang sama tapi TANPA "-pooler" (dipakai untuk migrasi)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

JWT_SECRET="ganti-dengan-string-acak-panjang"
PORT=3000
# Dipakai untuk membuat link reset password
CLIENT_URL="http://localhost:5173"

# Opsional di lokal: kalau diisi, gambar upload disimpan di Vercel Blob, bukan folder server/uploads
# BLOB_READ_WRITE_TOKEN=""

# Midtrans (https://dashboard.midtrans.com > Settings > Access Keys). Kosong = tanpa pembayaran online:
# pesanan langsung dianggap dibayar (development). Wajib diisi di Vercel.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Potongan platform untuk payout seller (persen)
PLATFORM_FEE_PERCENT=5
